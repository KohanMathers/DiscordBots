# Copy to .env and fill in. Real environment variables override this file.

# Required. Or set DISCORD_TOKEN_FILE=/path/to/secret instead.
DISCORD_TOKEN=

# SQLite only for now. sqlite:///relative/path.db or sqlite:////absolute/path.db
DATABASE_URL=sqlite:///data/mm.db

# Register commands instantly in these servers while testing (comma-separated). Empty in production.
DEV_GUILD_IDS=

# Only load these modules (comma-separated). Empty = everything this build ships. info and config always load.
MODULES=

# Privileged Message Content intent. Enables passive auto-responses and /purge contains:.
# Also turn it on in the Developer Portal before setting this to true.
ENABLE_MESSAGE_CONTENT=false

# Link shown in error replies and /bot info (default: the variant's support link)
SUPPORT_URL=

# /healthz and /metrics. On Pterodactyl the egg sets HTTP_PORT for you.
METRICS_PORT=

LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# Days a server's data is kept after the bot leaves it
GUILD_DATA_GRACE_DAYS=30

# ── QTIHelper only ──────────────────────────────────────────────
# Users who can always use QTI commands (replaces the old hard-coded user ID). Comma-separated IDs.
QTI_ADMIN_IDS=
# MOTD API: POST {"motd": "<text>"} with "Authorization: Bearer <token>"
QTI_MOTD_URL=https://api.quietterminal.co.uk/api/motd
QTI_MOTD_TOKEN=
