{
  "name": "twitch-announcer",
  "version": "3.0.0",
  "description": "Announces Twitch go-lives and YouTube uploads in Discord servers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "import-v2": "node --env-file-if-exists=.env src/tools/import-v2.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "fast-xml-parser": "^5.12.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
