# Copy to .env and fill in. Real environment variables override this file.

# Required
DISCORD_TOKEN=

# Bot owners for /status (comma-separated user IDs). Defaults to the application owner.
OWNER_IDS=

# sqlite:path/to/file.db (default sqlite:data/announcer.db) or postgres://user:pass@host/db
DATABASE_URL=sqlite:data/announcer.db

# Twitch: leave blank to disable. Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_POLL_INTERVAL=60s

# YouTube: leave blank to disable. Data API v3 key from https://console.cloud.google.com/
YOUTUBE_API_KEY=
YOUTUBE_POLL_INTERVAL=5m

# Items older than this are not announced after downtime (live streams always are).
CATCHUP_MAX_AGE=24h

# /healthz and /metrics
HTTP_PORT=8080

LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# Optional links shown by /info
INFO_AUTHOR_URL=
INFO_SUPPORT_URL=
INFO_SOURCE_URL=
