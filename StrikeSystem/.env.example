# Copy to .env and fill in. Real environment variables override this file.

# Required. Or set DISCORD_TOKEN_FILE=/path/to/secret instead.
DISCORD_TOKEN=

# Bot owners for /botadmin (comma-separated user IDs). Defaults to the application owner.
OWNER_IDS=

# Register commands in one guild only, for instant updates while testing. Leave empty in production.
DEV_GUILD_ID=

# Database, evidence files and backups live here.
DATA_DIR=data

# /healthz, /readyz and /metrics
HTTP_PORT=8080

LOG_LEVEL=info
# text or json
LOG_FORMAT=text

# Online database backups
BACKUP_INTERVAL=24h
BACKUP_KEEP=7

# How long a server's data is kept after the bot leaves it
GUILD_DATA_GRACE=30d

# Largest evidence/modmail file re-uploaded (bigger files are linked)
EVIDENCE_MAX_MB=8
