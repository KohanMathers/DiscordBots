{
  "name": "strike-system",
  "version": "2.0.0",
  "description": "Discord moderation bot built around strikes, cases and modmail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "import-legacy": "node --env-file-if-exists=.env src/tools/import-legacy.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.28.1",
    "kysely": "^0.29.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
